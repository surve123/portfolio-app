# Copy this file to ".env" in the server/ folder and fill in your real values.

# Port the Express server listens on.
PORT=5000

# The Gmail account that will SEND the email (can be the same as TO_EMAIL).
# You MUST use a Gmail "App Password", not your normal Gmail password:
#   1. Turn on 2-Step Verification: https://myaccount.google.com/security
#   2. Create an App Password: https://myaccount.google.com/apppasswords
#   3. Paste the 16-character app password below (no spaces).
EMAIL_USER=your.email@gmail.com
EMAIL_PASS=your16charapppassword

# Where contact-form messages should be delivered. Defaults to your own inbox
# if left unset, but it's clearer to set it explicitly.
TO_EMAIL=shreyas.surve02@gmail.com

# Comma-separated list of allowed client origins in production, e.g.:
# CLIENT_ORIGIN=https://shreyas-surve-portfolio.vercel.app
# Leave as "*" for local development.
CLIENT_ORIGIN=*
